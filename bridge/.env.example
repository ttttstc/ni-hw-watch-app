# Bind to every local interface so the watch can reach the bridge.
CODEX_WATCH_HOST=0.0.0.0
CODEX_WATCH_PORT=8787

# Recommended even on a trusted LAN. The watch can pass it as a Bearer header
# or, during the first connectivity spike, as ?token=...
CODEX_WATCH_TOKEN=replace-with-a-long-random-token
